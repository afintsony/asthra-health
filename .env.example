# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./astrahealth.db
# Production example: postgresql+psycopg2://user:password@host:5432/astrahealth
JWT_SECRET_KEY=            # required in production: python -c "import secrets;print(secrets.token_urlsafe(64))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
NASA_API_KEY=              # optional; https://api.nasa.gov/
MODEL_DIR=../models
DEMO_PASSWORD=             # optional demo seed password
VITE_API_BASE_URL=http://localhost:8000
